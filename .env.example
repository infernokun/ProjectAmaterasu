# Copy to .env and fill in. Real .env files are gitignored, so never put a secret in this file.
#
#   docker compose --env-file .env up -d
#
# Every value has a default in docker-compose.yml; anything left out here uses it.

# Images: <REGISTRY>/<NAMESPACE>/amaterasu-web:<TAG>
REGISTRY=docker.io
NAMESPACE=infernokun
TAG=latest

# Published ports. The API is bound to loopback because it has no authentication yet
# (see SECURITY.md); the web container reaches it over the compose network. Set
# REST_BIND=0.0.0.0 only if something outside this host must call the API directly.
WEB_PORT=8764
REST_PORT=8765
REST_BIND=127.0.0.1

# Postgres
POSTGRES_USER=amaterasu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=amaterasu

# Redis
REDIS_PASSWORD=change-me

# Encrypts stored server passwords and Proxmox API tokens. Changing it later makes existing
# remote servers unreadable, so pick a long random value once:
#   openssl rand -base64 32
ENCRYPTION_KEY=change-me

# Working directory for lab files on each Docker host
DOCKER_COMPOSE_PATH=/var/tmp/amaterasu
